{
  "uid": "foryn-local",
  "title": "Foryn / Local",
  "tags": ["foryn", "local", "k6"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {
    "list": [{
      "name": "testid",
      "label": "k6 test",
      "type": "query",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "query": "label_values(k6_http_reqs_total, testid)",
      "refresh": 2,
      "includeAll": true,
      "allValue": ".*",
      "multi": true,
      "current": {"text": "All", "value": "$__all"}
    }]
  },
  "panels": [
    {
      "id": 1, "title": "Application scrape status", "type": "stat",
      "description": "1 means Prometheus can scrape the host application. Start it with the local profile and observability properties.",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "up{job=\"foryn\"}", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 2, "title": "Server requests / second", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"foryn\",uri!~\"/actuator.*\"}[$__rate_interval]))"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 3, "title": "Server p95 latency", "type": "timeseries",
      "description": "Aggregated latency requires HTTP server request histograms from the local observability properties.",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"foryn\",uri!~\"/actuator.*\"}[$__rate_interval])))"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 4, "title": "Server 5xx / second", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"foryn\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval]))"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 5, "title": "JVM heap used", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 5},
      "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"foryn\",area=\"heap\"})"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}
    },
    {
      "id": 6, "title": "MySQL application connection pool", "type": "timeseries",
      "description": "HikariCP connections observed by the application; not a MySQL server exporter.",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 5},
      "targets": [
        {"refId": "A", "expr": "sum(hikaricp_connections_active{job=\"foryn\"})", "legendFormat": "active"},
        {"refId": "B", "expr": "sum(hikaricp_connections_pending{job=\"foryn\"})", "legendFormat": "pending"}
      ],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []}
    },
    {
      "id": 7, "title": "k6 requests / second", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 12},
      "targets": [{"refId": "A", "expr": "sum by (testid) (rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "{{testid}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 8, "title": "k6 p95 latency per run", "type": "timeseries",
      "description": "Client-observed p95 for this single k6 process. Percentiles are not aggregated across processes.",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 12},
      "targets": [{"refId": "A", "expr": "k6_http_req_duration_p95{testid=~\"$testid\",name=\"local-read\"}", "legendFormat": "{{testid}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 9, "title": "k6 failed request rate", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "foryn-prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 12},
      "targets": [{"refId": "A", "expr": "k6_http_req_failed_rate{testid=~\"$testid\",name=\"local-read\"}", "legendFormat": "{{testid}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    }
  ]
}
