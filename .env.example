# .env로 복사하고 로컬 비밀번호를 직접 설정한다. .env는 커밋하지 않는다.
# 아래 이름은 애플리케이션의 기존 DB 속성과 일치시킨다.
SPRING_PROFILES_ACTIVE=local
MYSQL_DATABASE=foryn
MYSQL_USER=foryn
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MONGO_DATABASE=foryn
MONGO_INITDB_ROOT_USERNAME=foryn_admin
MONGO_INITDB_ROOT_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# 기존 Apple, JWT, OpenAI, Firebase, Cloud Tasks, Sentry 값은
# 기존 환경변수 또는 비밀값 주입 경로로 별도 제공한다.
# 이 템플릿은 해당 자격증명을 대체하거나 복원하지 않는다.

# k6 설정은 필요할 때 변경한다. 기본값은 가상 사용자 1명으로 30초간 로컬 상태를 검사한다.
K6_BASE_URL=http://host.docker.internal:8080
K6_TARGET_PATH=/actuator/health
K6_VUS=1
K6_DURATION=30s
K6_TEST_ID=local
# K6_ACCESS_TOKEN=
